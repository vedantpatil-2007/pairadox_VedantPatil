# ==============================================================================
# SkillNear (PS03) Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your Supabase project credentials.
# Get these values from: Supabase Dashboard -> Project Settings -> API
#
# IMPORTANT SECURITY NOTICE:
# - ONLY provide your Project URL and Publishable (Anon) Key.
# - NEVER expose your Supabase service_role key in frontend client code.
# ==============================================================================

# Your Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Publishable / Anon Key (Safe for client browsers with RLS enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key-here
