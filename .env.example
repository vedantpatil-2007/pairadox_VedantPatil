# ==============================================================================
# SkillNear (PS03) Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your Supabase project credentials.
# Get these values from: Supabase Dashboard -> Project Settings -> API
#
# IMPORTANT SECURITY NOTICE:
# - ONLY provide your Project URL and Publishable (Anon) Key for client access.
# - NEVER expose your Supabase service_role key in frontend client code.
# - AI Concierge API keys MUST NOT have a VITE_ prefix to prevent bundle leakage.
# ==============================================================================

# Your Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Publishable / Anon Key (Safe for client browsers with RLS enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key-here

# ==============================================================================
# SkillNear AI Concierge (Live-Only Google Gemini 3.8 Flash)
# ==============================================================================
# Phase 2 Live-Only Assistant requires an official Google Gemini API key.
# Model: gemini-3.8-flash (Standard Free Tier: $0 cost, no credit card or billing).
# Obtain a free key at: https://aistudio.google.com
#
# STRICT SECURITY RULES:
# - DO NOT add a VITE_ prefix. The key is kept strictly server-side.
# - Never commit your .env file or push keys to source control.
# - In development: The key is loaded by Vite dev proxy (npm run dev).
# - In production: The key is loaded by the production server (npm run server).
#
# GEMINI_API_KEY=your-google-gemini-api-key-here
# Optional model override (defaults to gemini-3.8-flash):
# GEMINI_MODEL=gemini-3.8-flash

# ==============================================================================
# Hosting Environment (Render Web Service)
# ==============================================================================
# In production on Render, set these environment variables in your Dashboard:
# 1. VITE_SUPABASE_URL (Required at build time)
# 2. VITE_SUPABASE_PUBLISHABLE_KEY (Required at build time)
# 3. GEMINI_API_KEY (Required at runtime, server-side only)
# 4. GEMINI_MODEL=gemini-3.8-flash (Optional)
# 5. NODE_ENV=production (Set automatically or manually)
# Note: Render automatically provides PORT (e.g. 10000). The server reads process.env.PORT.
